/* 分享海报页面样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 海报容器 */
.poster-wrapper {
  position: relative;
  width: 600rpx;
  min-height: 900rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.poster-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 600rpx;
  height: 900rpx;
  opacity: 0;
}

.poster-image {
  width: 100%;
  display: block;
}

/* 生成中遮罩 */
.generating-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #4A90E2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading text {
  color: #666;
  font-size: 28rpx;
}

/* 操作按钮 */
.actions {
  display: flex;
  gap: 30rpx;
  margin-top: 40rpx;
  width: 100%;
  max-width: 600rpx;
}

.btn {
  flex: 1;
  height: 90rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  border: none;
}

.btn .icon {
  font-size: 32rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90E2 0%, #67B26F 100%);
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #4A90E2;
  border: 2rpx solid #4A90E2;
}

/* 提示信息 */
.tips {
  margin-top: 30rpx;
  color: #999;
  font-size: 26rpx;
}

/* 已保存提示 */
.saved-tip {
  margin-top: 30rpx;
  padding: 20rpx 40rpx;
  background: #f0f9eb;
  border: 1rpx solid #cceeb8;
  border-radius: 12rpx;
  color: #52c41a;
  font-size: 28rpx;
}

/* 底部说明 */
.footer-tip {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
}
