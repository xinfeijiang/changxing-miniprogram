<!-- 签到页面 - Stitch 风格 -->
<view class="checkin">
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
  </view>
  
  <block wx:else>
    <!-- 活动信息 -->
    <view class="activity-card card">
      <view class="activity-title">{{activity.title}}</view>
      <view class="activity-time">
        <text>📅 {{activity.startTime}} - {{activity.endTime}}</text>
      </view>
      <view class="activity-location">
        <text>📍 {{activity.location}}</text>
      </view>
    </view>
    
    <!-- 签到状态 -->
    <view class="status-card {{registration.status === 'checked-in' ? 'checked-in' : ''}}">
      <view wx:if="{{registration.status === 'checked-in'}}" class="status-icon success">
        ✓
      </view>
      <view wx:else class="status-icon pending">
        ⏳
      </view>
      
      <view class="status-text">
        <text wx:if="{{registration.status === 'checked-in'}}" class="success">已签到</text>
        <text wx:else class="pending">待签到</text>
      </view>
      
      <view wx:if="{{registration.checkinTime}}" class="checkin-time">
        签到时间：{{registration.checkinTime}}
      </view>
    </view>
    
    <!-- 签到码 -->
    <view class="ticket-section">
      <view class="ticket-label">签到码</view>
      <view class="ticket-code" bindtap="copyCode">
        {{registration.ticketCode}}
        <text class="copy-hint">点击复制</text>
      </view>
      
      <view class="ticket-tips">
        <text>请将签到码出示给活动工作人员进行核销</text>
      </view>
    </view>
    
    <!-- 操作说明 -->
    <view class="tips-section">
      <view class="tips-title">签到说明</view>
      <view class="tips-list">
        <view class="tip-item">
          <text class="tip-num">1</text>
          <text class="tip-text">活动现场出示此签到码</text>
        </view>
        <view class="tip-item">
          <text class="tip-num">2</text>
          <text class="tip-text">工作人员扫描或输入签到码</text>
        </view>
        <view class="tip-item">
          <text class="tip-num">3</text>
          <text class="tip-text">完成签到，领取活动物资</text>
        </view>
      </view>
    </view>
  </block>
</view>
