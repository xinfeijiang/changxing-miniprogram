/* 签到页面 - Stitch 风格 */
.checkin {
  min-height: 100vh;
  background: var(--stitch-bg);
  padding: 32rpx;
}

/* 活动卡片 */
.activity-card {
  margin-bottom: 24rpx;
}

.activity-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  margin-bottom: 16rpx;
}

.activity-time, .activity-location {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  margin-bottom: 8rpx;
}

/* 状态卡片 */
.status-card {
  background: var(--stitch-card);
  border: 1px solid var(--stitch-border);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.status-card.checked-in {
  border-color: var(--stitch-success);
  background: rgba(129, 201, 149, 0.05);
}

.status-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.status-icon.pending {
  background: rgba(253, 214, 99, 0.2);
  color: var(--stitch-warning);
}

.status-icon.success {
  background: var(--stitch-success);
  color: #191A1F;
}

.status-text {
  font-size: 36rpx;
  font-weight: 600;
}

.status-text .pending {
  color: var(--stitch-warning);
}

.status-text .success {
  color: var(--stitch-success);
}

.checkin-time {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

/* 签到码 */
.ticket-section {
  background: var(--stitch-card);
  border: 1px solid var(--stitch-border);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  margin-bottom: 24rpx;
}

.ticket-label {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  text-align: center;
  margin-bottom: 16rpx;
}

.ticket-code {
  font-size: 56rpx;
  font-weight: 700;
  font-family: 'SF Mono', monospace;
  color: var(--stitch-primary);
  text-align: center;
  letter-spacing: 8rpx;
  padding: 24rpx;
  background: var(--stitch-bg);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.copy-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--stitch-text-disabled);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

.ticket-tips {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

/* 说明 */
.tips-section {
  background: var(--stitch-card);
  border: 1px solid var(--stitch-border);
  border-radius: var(--radius-lg);
  padding: 32rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  margin-bottom: 20rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.tip-num {
  width: 40rpx;
  height: 40rpx;
  background: var(--gradient-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #191A1F;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  line-height: 40rpx;
}
