/* 首页 - Stitch 风格 */
.home {
  min-height: 100vh;
  background: var(--stitch-bg);
}

/* 头部 */
.home-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(25, 26, 31, 0.95);
  backdrop-filter: blur(12px);
  padding: 20rpx 32rpx;
  border-bottom: 1px solid var(--stitch-border);
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: var(--stitch-card);
  border: 1px solid var(--stitch-border);
  border-radius: var(--radius-lg);
  padding: 20rpx 24rpx;
  transition: all 0.2s ease;
}

.search-box:focus-within {
  border-color: var(--stitch-primary);
  box-shadow: 0 0 0 3px rgba(138, 180, 248, 0.1);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  background: transparent;
  border: none;
  color: var(--stitch-text-primary);
  font-size: 28rpx;
}

.search-placeholder {
  color: var(--stitch-text-disabled);
}

.search-btn {
  padding: 12rpx 24rpx;
  background: var(--gradient-primary);
  border-radius: var(--radius-md);
  color: #191A1F;
  font-size: 26rpx;
  font-weight: 500;
}

/* 标签 */
.tag-scroll {
  margin-top: 20rpx;
}

.tags {
  display: flex;
  gap: 16rpx;
  white-space: nowrap;
}

.tag {
  padding: 12rpx 28rpx;
  background: var(--stitch-card);
  border: 1px solid var(--stitch-border);
  border-radius: 24rpx;
  color: var(--stitch-text-secondary);
  font-size: 26rpx;
  transition: all 0.2s ease;
}

.tag-active {
  background: var(--gradient-primary);
  border-color: transparent;
  color: #191A1F;
  font-weight: 500;
}

/* 内容区 */
.home-content {
  height: calc(100vh - 200rpx);
  padding: 0 32rpx;
}

/* Section */
.section {
  padding: 32rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
}

.section-more {
  font-size: 26rpx;
  color: var(--stitch-primary);
}

/* 热门活动横向滚动 */
.hot-scroll {
  width: 100%;
  height: 360rpx;
}

.hot-list {
  display: flex;
  gap: 24rpx;
  padding-bottom: 8rpx;
}

.hot-card {
  width: 480rpx;
  height: 100%;
  flex-shrink: 0;
  background: var(--stitch-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
}

.hot-cover {
  width: 100%;
  height: 240rpx;
  background: var(--stitch-hover);
}

.hot-info {
  padding: 16rpx 20rpx;
}

.hot-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--stitch-text-primary);
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--stitch-text-secondary);
}

/* 活动卡片 */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-card {
  display: flex;
  padding: 0;
  overflow: hidden;
}

.activity-cover {
  width: 240rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: var(--stitch-hover);
}

.activity-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.activity-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--stitch-text-primary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.activity-desc {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.activity-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--stitch-text-secondary);
}

.meta-icon {
  font-size: 24rpx;
}

.activity-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.spots {
  display: flex;
  align-items: baseline;
}

.spots-num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--stitch-primary);
}

.spots-text {
  font-size: 22rpx;
  color: var(--stitch-text-secondary);
}

.price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  color: var(--stitch-error);
}

.price-num {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-error);
}

.price-free {
  font-size: 26rpx;
  color: var(--stitch-success);
  font-weight: 500;
}

/* 加载更多 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 0;
  color: var(--stitch-text-secondary);
  font-size: 26rpx;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--gradient-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  z-index: 99;
}

.fab-icon {
  font-size: 48rpx;
  color: #191A1F;
  font-weight: 300;
}
