<!-- 我的报名 - Stitch 风格 -->
<view class="my-registrations">
  <!-- 顶部标签 -->
  <view class="tabs">
    <scroll-view class="tabs-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="tabs-list">
        <view 
          wx:for="{{tabs}}" 
          wx:key="id" 
          class="tab {{activeTab === item.id ? 'tab-active' : ''}}"
          bindtap="onTabChange"
          data-id="{{item.id}}"
        >
          <text class="tab-name">{{item.name}}</text>
          <text wx:if="{{item.count > 0}}" class="tab-count">{{item.count}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
  
  <!-- 内容区 -->
  <scroll-view 
    class="content" 
    scroll-y="{{true}}"
    bindscrolltolower="onReachBottom"
  >
    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading">
      <view class="loading-spinner"></view>
    </view>
    
    <!-- 列表 -->
    <block wx:else>
      <view wx:for="{{registrations}}" wx:key="id" class="registration-card card">
        <!-- 活动信息 -->
        <view class="card-header" bindtap="goToActivity" data-id="{{item.activity._id}}">
          <image class="card-cover" src="{{item.activity.cover}}" mode="aspectFill" />
          <view class="card-info">
            <view class="card-title">{{item.activity.title}}</view>
            <view class="card-meta">
              <text>📅 {{item.activity.startTime}}</text>
              <text>📍 {{item.activity.location}}</text>
            </view>
          </view>
        </view>
        
        <!-- 报名信息 -->
        <view class="card-body">
          <view class="reg-status">
            <text class="status-badge status-{{item.status}}">
              {{item.status === 'pending' ? '待审核' : 
                item.status === 'confirmed' ? '已确认' : 
                item.status === 'checked-in' ? '已签到' : 
                item.status === 'cancelled' ? '已取消' : '待支付'}}
            </text>
            <text class="order-id">订单号：{{item.orderId}}</text>
          </view>
          
          <!-- 支付状态 -->
          <view wx:if="{{item.paymentStatus === 'unpaid' && item.paymentAmount > 0}}" class="payment-info">
            <text class="payment-amount">待支付：¥{{item.paymentAmount}}</text>
            <button class="btn btn-primary btn-sm">去支付</button>
          </view>
          
          <!-- 操作按钮 -->
          <view class="card-actions">
            <button 
              class="btn btn-secondary btn-sm" 
              bindtap="goToRegistration"
              data-id="{{item._id}}"
            >
              查看详情
            </button>
            <button 
              wx:if="{{item.status === 'confirmed' && item.activity.status === 'published'}}"
              class="btn btn-outline btn-sm"
              bindtap="goToCheckin"
              data-id="{{item._id}}"
            >
              签到码
            </button>
          </view>
        </view>
      </view>
      
      <!-- 加载更多 -->
      <view wx:if="{{loadingMore}}" class="loading-more">
        <view class="loading-spinner"></view>
        <text>加载中...</text>
      </view>
      
      <!-- 空状态 -->
      <view wx:if="{{!loading && registrations.length === 0}}" class="empty">
        <text class="empty-icon">📭</text>
        <text class="empty-text">暂无报名记录</text>
      </view>
    </block>
  </scroll-view>
</view>
