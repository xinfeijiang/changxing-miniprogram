/* 我的报名 - Stitch 风格 */
.my-registrations {
  min-height: 100vh;
  background: var(--stitch-bg);
}

/* 标签 */
.tabs {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--stitch-bg);
  border-bottom: 1px solid var(--stitch-border);
}

.tabs-scroll {
  padding: 0 16rpx;
}

.tabs-list {
  display: flex;
  gap: 8rpx;
  padding: 16rpx 0;
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: var(--stitch-card);
  border: 1px solid var(--stitch-border);
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.tab-active {
  background: var(--gradient-primary);
  border-color: transparent;
}

.tab-name {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
}

.tab-active .tab-name {
  color: #191A1F;
  font-weight: 500;
}

.tab-count {
  padding: 4rpx 12rpx;
  background: var(--stitch-hover);
  border-radius: 12rpx;
  font-size: 20rpx;
  color: var(--stitch-text-secondary);
}

.tab-active .tab-count {
  background: rgba(0, 0, 0, 0.1);
  color: #191A1F;
}

/* 内容 */
.content {
  height: calc(100vh - 100rpx);
  padding: 24rpx;
}

/* 报名卡片 */
.registration-card {
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  gap: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1px solid var(--stitch-border);
}

.card-cover {
  width: 160rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  background: var(--stitch-hover);
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--stitch-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--stitch-text-secondary);
}

/* 卡片body */
.card-body {
  padding-top: 20rpx;
}

.reg-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-pending {
  background: rgba(253, 214, 99, 0.2);
  color: var(--stitch-warning);
}

.status-confirmed {
  background: rgba(129, 201, 149, 0.2);
  color: var(--stitch-success);
}

.status-checked-in {
  background: rgba(138, 180, 248, 0.2);
  color: var(--stitch-primary);
}

.status-cancelled {
  background: rgba(242, 139, 130, 0.2);
  color: var(--stitch-error);
}

.order-id {
  font-size: 20rpx;
  color: var(--stitch-text-disabled);
}

/* 支付信息 */
.payment-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background: rgba(242, 139, 130, 0.1);
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
}

.payment-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--stitch-error);
}

/* 操作按钮 */
.card-actions {
  display: flex;
  gap: 16rpx;
}

.card-actions .btn {
  flex: 1;
}
