# 环境配置
PORT=3000
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb://localhost:27017/changxing

# JWT
JWT_SECRET=your-super-secret-key-change-in-production

# 微信小程序（需要替换为真实的）
WX_APP_ID=your_app_id
WX_APP_SECRET=your_app_secret
WX_MCH_ID=your_mch_id
WX_API_KEY=your_api_key

# 阿里云OSS（可选，用于图片存储）
OSS_REGION=oss-cn-shanghai
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_oss_bucket
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com

# 阿里云短信（可选，用于通知）
ALI_ACCESS_KEY_ID=your_ali_access_key_id
ALI_ACCESS_KEY_SECRET=your_ali_access_key_secret
SMS_SIGN_NAME=畅行活动
SMS_TEMPLATE_CODE=SMS_xxxxx

# 邮件服务（可选，用于通知）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_password

# 前端API地址（生产环境）
API_BASE_URL=https://your-api-domain.com/api
